# Copy to .env.local and fill in. Never commit real values.

# MongoDB (Atlas or self-hosted). The /admin passcode lives in the `admin` collection (default "123"). Gallery photos live in `gallery`, projects in `projects` (seed: scripts/seed-projects.mjs).
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/
MONGODB_DB=gps

# UploadThing: dashboard > API Keys > UPLOADTHING_TOKEN
UPLOADTHING_TOKEN=

# Enquiry emails via Gmail SMTP (app password, not the normal password). Port 465 = SSL, 587 = STARTTLS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="GPS Website <you@gmail.com>"
# Inbox that receives website enquiries.
EMAIL_TO=sales@example.com
