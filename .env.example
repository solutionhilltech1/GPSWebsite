# Copy to .env.local and fill in. Never commit real values.

# /admin passcode. Changing it logs everyone out.
ADMIN_PASSWORD=

# MongoDB (Atlas or self-hosted). Gallery captions live in the `gallery` collection.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/
MONGODB_DB=gps

# UploadThing: dashboard > API Keys > UPLOADTHING_TOKEN
UPLOADTHING_TOKEN=

# Enquiry emails via Gmail SMTP (app password, not the normal password). Port 465 = SSL, 587 = STARTTLS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="GPS Website <you@gmail.com>"
# Inbox that receives website enquiries.
EMAIL_TO=sales@example.com
